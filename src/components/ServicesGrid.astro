const doubleServices = [...services, ...services];
---

<section id="layanan" class="py-8 bg-nara-50 border-y border-nara-200/60 overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="w-3 h-3 rounded-full bg-nara-600 animate-pulse"></span>
      <h2 class="text-xl sm:text-2xl font-extrabold text-nara-900 tracking-tight">
        Layanan Nara Dental
      </h2>
      <span class="text-xs font-semibold text-nara-700 bg-nara-200/60 px-2.5 py-0.5 rounded-full hidden sm:inline-block">
        12 Layanan Medis & Estetika
      </span>
    </div>
  </div>

  <!-- 1-Line Infinite Looping Slider Container -->
  <div class="relative w-full overflow-hidden py-2">
    
    <!-- Left & Right Fade Shadows -->
    <div class="absolute top-0 bottom-0 left-0 w-16 bg-gradient-to-r from-nara-50 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute top-0 bottom-0 right-0 w-16 bg-gradient-to-l from-nara-50 to-transparent z-10 pointer-events-none"></div>

    <!-- Scrolling Track -->
    <div class="marquee-track">
      {doubleServices.map((item) => (
        <a
          href={`https://wa.me/6281235887859?text=Halo%20Nara%20Dental,%20saya%20ingin%20tanya%20detail%20layanan%20${encodeURIComponent(item.name)}.`}
          target="_blank"
          rel="noopener noreferrer"
          class={`flex items-center gap-3 px-5 py-3 rounded-2xl border transition-all duration-300 shrink-0 shadow-sm hover:shadow-md transform hover:-translate-y-0.5 ${
            item.isFeatured
              ? 'bg-white border-nara-400 ring-1 ring-nara-300 text-nara-900'
              : 'bg-white/90 border-nara-200 hover:border-nara-400 text-nara-900'
          }`}
        >
          <!-- Flat SVG Icon Circle with Brand Colors -->
          <div class="w-8 h-8 rounded-xl bg-nara-100 flex items-center justify-center shrink-0 border border-nara-200/80">
            <Fragment set:html={item.iconSvg} />
          </div>

          <!-- Title -->
          <span class="font-bold text-sm whitespace-nowrap tracking-tight text-nara-900">
            {item.name}
          </span>

          <!-- Badge -->
          {item.isFeatured ? (
            <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-nara-600 text-white uppercase tracking-wider shrink-0">
              Unggulan
            </span>
          ) : (
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-nara-100 text-nara-700 shrink-0">
              {item.tag}
            </span>
          )}

          <!-- Arrow Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-nara-400 opacity-60 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  @keyframes marqueeContinuous {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: max-content;
    animation: marqueeContinuous 25s linear infinite;
    will-change: transform;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }
</style>
