---
const mapsUrl = "https://www.google.com/maps/place/Nara+Dental+Clinic+%7C+Klinik+Dokter+Gigi+Surabaya/data=!4m2!3m1!1s0x0:0x21a873170b10a36d?sa=X&ved=1t:2428&ictx=111";
const waUrl = "https://wa.me/6281235887859?text=Halo%20Nara%20Dental,%20saya%20ingin%20tanya%20petunjuk%20arah%20dan%20lokasi%20klinik.";
const phoneUrl = "tel:081235887859";
---

<section id="lokasi" class="py-16 lg:py-24 bg-nara-50/60 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-nara-100 text-nara-700 mb-3">
        <span class="w-2 h-2 rounded-full bg-nara-600"></span>
        Lokasi Mudah Dijangkau
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-nara-900 tracking-tight">
        Temukan Nara Dental Clinic Surabaya
      </h2>
      <p class="text-nara-900/75 text-base mt-2">
        Berada di kawasan strategis Gubeng, Surabaya. Dilengkapi area parkir luas dan akses jalan utama yang nyaman.
      </p>
    </div>

    <!-- Main Grid: Info Box & Embedded Map -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Info Box -->
      <div class="lg:col-span-5 bg-white rounded-3xl p-8 border border-nara-200 shadow-lg flex flex-col justify-between">
        <div class="space-y-6">
          
          <!-- Address Card -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-nara-100 border border-nara-200 text-nara-700 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-nara-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-extrabold text-lg text-nara-900 mb-1">Alamat Lengkap</h3>
              <p class="text-xs sm:text-sm text-nara-900/80 leading-relaxed font-normal">
                Jl. Barata Jaya No.41, RT.004/RW.07, Baratajaya, Kec. Gubeng, Kota Surabaya, Jawa Timur 60284
              </p>
            </div>
          </div>

          <!-- Operating Hours Card -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-nara-100 border border-nara-200 text-nara-700 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-nara-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-extrabold text-lg text-nara-900 mb-1">Jam Operasional Klinik</h3>
              <div class="text-xs sm:text-sm text-nara-900/80 space-y-1">
                <p><strong class="font-semibold text-nara-900">Senin – Jumat:</strong> 10.00 – 20.00 WIB</p>
                <p><strong class="font-semibold text-nara-900">Sabtu:</strong> 10.00 – 15.00 WIB</p>
                <p class="text-nara-600 font-medium italic text-[11px] pt-1">*Minggu & Hari Libur: Melayani janji temu khusus</p>
              </div>
            </div>
          </div>

          <!-- Landmark & Parking Tip -->
          <div class="p-4 rounded-2xl bg-nara-50 border border-nara-200 text-xs text-nara-900/80 flex items-start gap-3">
            <div class="w-7 h-7 rounded-xl bg-nara-100 border border-nara-200 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-nara-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="font-bold text-nara-900 mb-0.5">Patokan Lokasi:</p>
              <p>Dekat kawasan Baratajaya Gubeng, area parkir aman & nyaman untuk kendaraan roda dua maupun empat.</p>
            </div>
          </div>

        </div>

        <!-- Action Buttons -->
        <div class="pt-6 mt-6 border-t border-nara-100 space-y-3">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full py-3.5 rounded-2xl font-bold text-sm text-white bg-nara-600 hover:bg-nara-700 shadow-md transition-all"
          >
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            Tanya Admin WA
          </a>

          <div class="grid grid-cols-2 gap-3">
            <a
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 py-2.5 rounded-xl font-bold text-xs text-nara-900 bg-nara-100 hover:bg-nara-200 transition-colors"
            >
              <svg class="w-4 h-4 text-nara-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
              Buka Rute di Google Maps
            </a>
            <a
              href={phoneUrl}
              class="flex items-center justify-center gap-2 py-2.5 rounded-xl font-bold text-xs text-nara-900 bg-nara-100 hover:bg-nara-200 transition-colors"
            >
              <svg class="w-4 h-4 text-nara-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Telepon Klinik
            </a>
          </div>
        </div>

      </div>

      <!-- Right Interactive Map Embed -->
      <div class="lg:col-span-7 relative min-h-[400px] rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-nara-200">
        <iframe
          title="Peta Lokasi Nara Dental Clinic Surabaya"
          src="https://maps.google.com/maps?q=-7.2987375,112.758489&z=17&output=embed"
          class="w-full h-full min-h-[420px] border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

    </div>

  </div>
</section>
