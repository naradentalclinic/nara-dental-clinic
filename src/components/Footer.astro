---
const mapLink = "https://www.google.com/maps/place/Nara+Dental+Clinic+%7C+Klinik+Dokter+Gigi+Surabaya/data=!4m2!3m1!1s0x0:0x21a873170b10a36d?sa=X&ved=1t:2428&ictx=111";
const waLink = "https://wa.me/6281235887859";
---

<footer id="kontak" class="bg-nara-dark text-white pt-16 pb-12 border-t border-nara-900 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-nara-800">
      
      <!-- Brand & About -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/logo.png"
            alt="Nara Dental Care Logo"
            class="w-10 h-10 rounded-2xl object-cover shadow-sm"
          />
          <div>
            <span class="font-extrabold text-xl tracking-tight leading-none text-white block">
              NARA DENTAL
            </span>
            <span class="text-xs text-nara-300 italic tracking-wider">
              Your smiles matters
            </span>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-nara-100/70 leading-relaxed max-w-sm">
          Klinik kesehatan gigi terpercaya di Surabaya. Menghadirkan perawatan profesional, ramah, aman, dan transparan bagi seluruh keluarga.
        </p>

        <!-- Social Media Icons -->
        <div class="pt-2">
          <p class="text-xs font-bold uppercase text-nara-300 tracking-wider mb-3">Ikuti Media Sosial Kami</p>
          <div class="flex items-center gap-3">
            <a
              href="https://instagram.com/nara.dentalclinic"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-xl bg-nara-800 hover:bg-nara-600 text-nara-200 hover:text-white flex items-center justify-center transition-all"
              aria-label="Instagram Nara Dental Clinic"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a
              href="https://threads.net/@nara.dentalclinic"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-xl bg-nara-800 hover:bg-nara-600 text-nara-200 hover:text-white flex items-center justify-center transition-all text-xs font-bold"
              aria-label="Threads Nara Dental Clinic"
            >
              TH
            </a>
            <a
              href="https://tiktok.com/@nara.dental"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-xl bg-nara-800 hover:bg-nara-600 text-nara-200 hover:text-white flex items-center justify-center transition-all"
              aria-label="TikTok Nara Dental Clinic"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .56.04.82.12V9.4a6.27 6.27 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.47V13a8.28 8.28 0 0 0 5.73 2.26V11.8a4.83 4.83 0 0 1-3.77-1.34v-3.77h3.77z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Nav Links -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="font-bold text-sm text-white uppercase tracking-wider">Navigasi</h4>
        <ul class="space-y-2 text-xs sm:text-sm text-nara-100/75">
          <li><a href="#beranda" class="hover:text-nara-300 transition-colors">Beranda</a></li>
          <li><a href="#layanan" class="hover:text-nara-300 transition-colors">Layanan Medis</a></li>
          <li><a href="#keunggulan" class="hover:text-nara-300 transition-colors">Keunggulan</a></li>
          <li><a href="#dokter" class="hover:text-nara-300 transition-colors">Tim Dokter</a></li>
          <li><a href="#tentang" class="hover:text-nara-300 transition-colors">Tentang Kami</a></li>
          <li><a href="#galeri" class="hover:text-nara-300 transition-colors">Galeri Klinik</a></li>
          <li><a href="#ulasan" class="hover:text-nara-300 transition-colors">Ulasan Pasien</a></li>
          <li><a href="#booking" class="hover:text-nara-300 transition-colors">Alur Booking</a></li>
          <li><a href="#lokasi" class="hover:text-nara-300 transition-colors">Peta Lokasi</a></li>
        </ul>
      </div>

      <!-- Operational Info & Address -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-bold text-sm text-white uppercase tracking-wider">Lokasi & Kontak</h4>
        <div class="space-y-2.5 text-xs sm:text-sm text-nara-100/80 leading-relaxed">
          <p>
            <strong class="text-white block font-semibold">Alamat Klinik:</strong>
            Jl. Barata Jaya No.41, RT.004/RW.07, Baratajaya, Kec. Gubeng, Surabaya, Jawa Timur 60284
          </p>
          <p>
            <strong class="text-white block font-semibold">Telepon / WhatsApp:</strong>
            <a href={waLink} target="_blank" class="text-nara-300 hover:underline">0812-3588-7859</a>
          </p>
          <p>
            <strong class="text-white block font-semibold">Email:</strong>
            <a href="mailto:nara.dentalspace@gmail.com" class="text-nara-300 hover:underline">nara.dentalspace@gmail.com</a>
          </p>
        </div>

        <div class="pt-2">
          <a
            href={mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-nara-900 bg-nara-300 hover:bg-nara-200 transition-all"
          >
            <svg class="w-4 h-4 text-nara-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Buka di Google Maps
          </a>
        </div>
      </div>

      <!-- Operational Hours & Payments -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="font-bold text-sm text-white uppercase tracking-wider">Jam Buka Klinik</h4>
        <div class="bg-nara-800/80 p-4 rounded-2xl border border-nara-700 space-y-2 text-xs">
          <div class="flex justify-between items-center text-nara-100">
            <span class="font-medium">Senin – Jumat</span>
            <span class="font-bold text-nara-300">10.00 - 20.00 WIB</span>
          </div>
          <div class="flex justify-between items-center text-nara-100">
            <span class="font-medium">Sabtu</span>
            <span class="font-bold text-nara-300">10.00 - 15.00 WIB</span>
          </div>
          <div class="pt-1 border-t border-nara-700/60 flex justify-between items-center text-nara-400">
            <span>Minggu & Hari Libur</span>
            <span class="italic">Tutup / Janji Temu</span>
          </div>
        </div>

        <!-- Payment Accepted Badges -->
        <div>
          <p class="text-xs font-bold uppercase text-nara-300 tracking-wider mb-2">Metode Pembayaran</p>
          <div class="flex flex-wrap gap-1.5">
            {["QRIS", "Debit Card", "Credit Card", "Transfer", "Cash"].map((p) => (
              <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-nara-800 text-nara-200 border border-nara-700">
                {p}
              </span>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-nara-100/50">
      <p>© 2026 Nara Dental Clinic. All rights reserved.</p>
      <p>Klinik Dokter Gigi Surabaya | Gubeng, Baratajaya</p>
    </div>

  </div>
</footer>
