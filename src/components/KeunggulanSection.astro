---
const values = [
  {
    step: "01",
    title: "Tim Dokter Gigi Umum & Spesialis Berpengalaman",
    desc: "Perawatan kesehatan gigi yang optimal dan tepercaya, didukung oleh dokter gigi umum maupun spesialis yang ramah, komunikatif dan siap mendengarkan setiap kebutuhan serta kenyamananmu.",
    iconSvg: `<svg class="w-6 h-6 text-nara-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`
  },
  {
    step: "02",
    title: "Peralatan Modern & Teknologi Terkini",
    desc: "Menggunakan peralatan medis terkini untuk memastikan proses perawatan lebih tepat, minim rasa sakit, dan akurat.",
    iconSvg: `<svg class="w-6 h-6 text-nara-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`
  },
  {
    step: "03",
    title: "Perawatan Nyaman & Transparansi Biaya",
    desc: "Konsep pelayanan yang ramah dan berorientasi pada kebutuhan pasien, serta kejelasan estimasi biaya sebelum tindakan dilakukan.",
    iconSvg: `<svg class="w-6 h-6 text-nara-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`
  },
  {
    step: "04",
    title: "Standar Sterilitas Alat yang Tinggi",
    desc: "Jaminan kebersihan alat dan ruang perawatan dengan protokol higienis yang ketat demi keamanan dan ketenangan pasien.",
    iconSvg: `<svg class="w-6 h-6 text-nara-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4M4 19h4M13 3l.5 1.5L15 5l-1.5.5L13 7l-.5-1.5L11 5l1.5-.5L13 3zM19 11l.5 1.5L21 13l-1.5.5L19 15l-.5-1.5L17 13l1.5-.5L19 11z"/></svg>`
  }
];
---

<section id="keunggulan" class="py-16 lg:py-20 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-nara-100 text-nara-700 mb-3">
        <span class="w-2 h-2 rounded-full bg-nara-600"></span>
        Mengapa Memilih Kami
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-nara-900 tracking-tight">
        Keunggulan Utama Nara Dental
      </h2>
      <p class="text-nara-900/75 text-base mt-3">
        Alasan mengapa pasien mempercayakan kesehatan dan estetika senyum keluarga kepada Nara Dental Clinic.
      </p>
    </div>

    <!-- 4 Core Value Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {values.map((item) => (
        <div class="bg-nara-50/70 rounded-3xl p-7 border border-nara-100 hover:border-nara-300 hover:bg-white transition-all duration-300 shadow-sm hover:shadow-xl flex flex-col justify-between group">
          <div>
            <!-- Icon & Step Number -->
            <div class="flex items-center justify-between mb-6">
              <div class="w-12 h-12 rounded-2xl bg-white border border-nara-200 flex items-center justify-center shadow-xs group-hover:scale-110 group-hover:bg-nara-600 group-hover:text-white transition-all duration-300">
                <Fragment set:html={item.iconSvg} />
              </div>
              <span class="text-2xl font-extrabold text-nara-300 font-mono group-hover:text-nara-500 transition-colors">
                {item.step}
              </span>
            </div>

            <!-- Title -->
            <h3 class="font-extrabold text-lg text-nara-900 mb-3 leading-snug group-hover:text-nara-700 transition-colors">
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-nara-900/75 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <!-- Bottom check mark -->
          <div class="pt-6 mt-6 border-t border-nara-200/60 flex items-center justify-between text-xs font-semibold text-nara-600">
            <span>Standar Nara Dental</span>
            <span class="w-5 h-5 rounded-full bg-nara-100 text-nara-700 flex items-center justify-center font-bold text-[10px]">✓</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
