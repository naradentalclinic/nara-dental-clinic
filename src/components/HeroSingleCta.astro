---
const waUrl = "https://wa.me/6281235887859?text=Halo%20Nara%20Dental,%20saya%20ingin%20konsultasi%20dan%20reservasi%20pemeriksaan%20gigi%20di%20Surabaya.";
---

<section id="beranda" class="relative pt-8 pb-16 lg:pt-16 lg:pb-24 overflow-hidden bg-gradient-to-b from-nara-50/80 via-white to-nara-50/30">
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-nara-100/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Content & Single CTA -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase bg-nara-100 text-nara-800 border border-nara-200/80 shadow-xs">
          <span class="w-2.5 h-2.5 rounded-full bg-nara-600 animate-pulse"></span>
          Klinik Dokter Gigi Terdekat di Surabaya
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-nara-900 tracking-tight leading-tight sm:leading-tight">
          Perawatan Gigi <span class="text-nara-600 underline decoration-nara-300 underline-offset-4">Nyaman & Professional</span> dekat Lokasi Anda
        </h1>

        <!-- Subheadline -->
        <p class="text-nara-800/80 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Nara Dental Care hadir di kawasan strategis Baratajaya Gubeng, Surabaya. Menghadirkan tim dokter spesialis berpengalaman, ruang tindakan steril, dan suasana homy tanpa rasa cemas.
        </p>

        <!-- Feature Chips -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-1">
          <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-nara-100 text-xs font-semibold text-nara-900 shadow-xs">
            <svg class="w-4 h-4 text-nara-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Dokter Spesialis Lengkap
          </div>
          <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-nara-100 text-xs font-semibold text-nara-900 shadow-xs">
            <svg class="w-4 h-4 text-nara-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Peralatan Medis Steril
          </div>
          <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-nara-100 text-xs font-semibold text-nara-900 shadow-xs">
            <svg class="w-4 h-4 text-nara-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Harga Transparan
          </div>
        </div>

        <!-- SINGLE Call To Action Button (WhatsApp) -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-bold text-white bg-nara-600 hover:bg-nara-700 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all text-base sm:text-lg w-full sm:w-auto"
          >
            <svg class="w-6 h-6 fill-current text-white" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.002 3.66 3.745-.983z"/>
            </svg>
            Konsultasi & Reservasi via WhatsApp
          </a>
        </div>

        <p class="text-xs text-nara-500 italic">
          *Respon cepat admin klinik untuk informasi jadwal & janji temu.
        </p>

      </div>

      <!-- Right Column: Hero Visual Image Card -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-white">
          <img
            src="/images/Nara Dental Clinic Surabaya.jpeg"
            alt="Nara Dental Clinic Surabaya Terdekat"
            class="w-full h-[420px] sm:h-[480px] object-cover"
          />
          
          <!-- Rating Overlay Card -->
          <div class="absolute bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-nara-100 shadow-lg flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-nara-100 text-nara-700 flex items-center justify-center font-bold text-lg">
                ★
              </div>
              <div>
                <p class="font-extrabold text-sm text-nara-900">Rating 4.9 / 5.0</p>
                <p class="text-xs text-nara-600 font-medium">500+ Pasien Puas di Surabaya</p>
              </div>
            </div>
            <span class="text-xs font-extrabold text-white bg-nara-600 px-3 py-1.5 rounded-full">
              Terpercaya
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
